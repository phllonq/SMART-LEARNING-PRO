# ==============================================================================
# SMART LEARNING PRO - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# APP CONFIGURATION
PROJECT_NAME="SMART LEARNING PRO"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api/v1"
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
FRONTEND_URL="http://localhost:3000"

# SECURITY & AUTHENTICATION
SECRET_KEY="smart-learning-pro-super-secret-key-change-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=False
COOKIE_SAMESITE="lax"

# DATABASE (PostgreSQL / SQLite fallback for development)
# For local Docker: postgresql+asyncpg://postgres:postgres@localhost:5432/smart_learning_pro
# For local dev without docker running: sqlite+aiosqlite:///./database/smart_learning.db
DATABASE_URL="sqlite+aiosqlite:///./database/smart_learning.db"
DATABASE_URL_SYNC="sqlite:///./database/smart_learning.db"
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/smart_learning_pro"
# DATABASE_URL_SYNC="postgresql://postgres:postgres@localhost:5432/smart_learning_pro"

# REDIS (Cache & Rate Limiting)
REDIS_URL="redis://localhost:6379/0"
USE_IN_MEMORY_CACHE_FALLBACK=True

# AI CONFIGURATION
AI_PROVIDER="mock" # "mock" or "google"
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
GEMINI_MODEL="gemini-3.8-flash"
AI_TIMEOUT_SECONDS=15.0
AI_MAX_RETRIES=2
AI_RETRY_BACKOFF_BASE=0.5

# STORAGE (MinIO / S3 or Local disk)
STORAGE_TYPE="local" # "local" or "s3"
LOCAL_STORAGE_PATH="./storage"
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_NAME="smart-learning-materials"

# INITIAL ADMIN SETUP
INITIAL_ADMIN_EMAIL="admin@smartlearning.vn"
INITIAL_ADMIN_PASSWORD="AdminSecurePassword123!"
INITIAL_ADMIN_NAME="System Administrator"
